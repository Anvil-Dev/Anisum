{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "name": "${mod_name}",
  "version": "${mod_version}",
  "description": "${mod_description}",
  "authors": [
    {
      "name": "Anvil-Dev",
      "contact": {
        "homepage": "https://github.com/Anvil-Dev"
      }
    }
  ],
  "license": "${mod_license}",
