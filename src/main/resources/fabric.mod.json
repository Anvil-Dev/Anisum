  },
  "environment": "*",
  "accessWidener" : "anisum.classtweaker",
  "entrypoints": {
    "main": [
      "dev.anvilcraft.resource.anisum.AnisumFabric"
    ]
  },
  "mixins": [
    "anisum.json"
  ],
  "depends": {
    "minecraft": "${minecraft_dependency}"
  }
}
